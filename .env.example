# Copy to .env and fill in. Never commit .env.
SENSECAP_API_ID=
SENSECAP_API_KEY=
SENSECAP_BASE_URL=https://sensecap.seeed.cc/openapi
# Comma-separated EUIs. Each must exist in sensor_devices.
DEVICE_EUIS=
# Supabase session pooler string (port 5432), not the direct IPv6 one.
DATABASE_URL=
# Healthchecks.io ping URLs.
HC_JOB_URL=
HC_ALPHA_URL=
# Pinged only when a soil moisture reading above 0 is under 30 minutes old.
HC_MOISTURE_URL=
# Read-only role (telemetry_reader) pooler string, used by dashboard_test.py.
READER_DATABASE_URL=
