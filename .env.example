# Copy to .env and fill in. Never commit .env.
SENSECAP_API_ID=
SENSECAP_API_KEY=
SENSECAP_BASE_URL=https://sensecap.seeed.cc/openapi
# Comma-separated EUIs. Each must exist in sensor_devices.
